        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));pm.test('effect once, deliveries twice',()=>{const d=pm.response.json();pm.expect(d.notifications.length).eql(1);pm.expect(d.inbox[0].deliveries).eql(2);pm.expect(d.events[0].attempts).eql(1);pm.expect(d.events[0].deliveredAt).to.be.a('string');pm.expect(d.projection[0].state).eql('CONFIRMED');});"
            ]
          }
        }
      ]
    },
