        "url": "{{baseUrl}}/api/holds",
        "body": {
          "mode": "raw",
          "raw": "{\"eventId\":\"{{eventId}}\",\"seatNumber\":1,\"buyerId\":\"first-{{runKey}}\",\"ttlSeconds\":120}",
