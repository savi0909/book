{
  "info": {
    "name": "Ticket scenario 4: transactional outbox and inbox",
    "description": "Enable base+failover+outbox overlay; both maintenance/dispatch loops OFF. Local retained fixtures, no sends/deletion/reset. Run sequentially. The runtime harness additionally proves actual API crashes at both commit gaps.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Manual outbox topology",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/demo/outbox/controls"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));pm.test('automatic dispatcher disabled',()=>pm.expect(pm.response.json().automaticDispatch).eql(false));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Fresh retained event",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/demo/events",
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"outbox-{{$guid}}\",\"seatCount\":2}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201',()=>pm.response.to.have.status(201));pm.environment.set('eventId',pm.response.json().id);pm.environment.set('runKey',pm.variables.replaceIn('{{$guid}}'));['first','second','paymentId','outboxId','confirmId','cancelId'].forEach(k=>pm.environment.unset(k));"
            ]
          }
        }
      ]
    },
    {
      "name": "Hold first",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
