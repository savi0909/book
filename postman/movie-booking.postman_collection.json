{
  "info": {
    "name": "SD Book My Show - atomic groups and payment retries",
    "description": "Run with base+failover+movie manual overlay. Creates retained fixtures. No real payments. Do not run during scheduled-worker mode.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Create retained multiplex with five screens",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('runId',pm.variables.replaceIn('{{$guid}}'));['multiplexId','screenId','movieId','showId','bookingId','paymentId','failedPaymentId','secondBookingId'].forEach(k=>pm.environment.unset(k));const start=new Date(Date.now()+86400000);pm.environment.set('showStart',start.toISOString());pm.environment.set('showDate',new Date(start.getTime()+19800000).toISOString().slice(0,10));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
              "const movieResult=pm.response.json();",
              "pm.environment.set('multiplexId',movieResult.id);pm.environment.set('screenId',movieResult.screens[0].id);pm.test('Five screens and 10/20/70 layout',()=>{pm.expect(movieResult.screens).to.have.lengthOf(5);pm.expect(movieResult.screens[0].categorySeats).to.eql({A:20,B:40,C:140});});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/demo/movie/multiplexes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Movie study {{runId}}\",\n  \"zoneId\": \"Asia/Kolkata\",\n  \"screens\": [\n    {\n      \"name\": \"Screen 1\",\n      \"seatCount\": 200\n    },\n    {\n      \"name\": \"Screen 2\",\n      \"seatCount\": 200\n    },\n    {\n      \"name\": \"Screen 3\",\n      \"seatCount\": 200\n    },\n    {\n      \"name\": \"Screen 4\",\n      \"seatCount\": 200\n    },\n    {\n      \"name\": \"Screen 5\",\n      \"seatCount\": 200\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
