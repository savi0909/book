    {
      "name": "09 Atomically hold seats across all categories",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
              "const movieResult=pm.response.json();",
              "pm.environment.set('bookingId',movieResult.id);pm.environment.set('expiresAt',movieResult.expiresAt);pm.test('Whole group and server-priced total',()=>{pm.expect(movieResult.seats.map(s=>s.seatNumber)).to.eql([1,21,61]);pm.expect(movieResult.amountMinor).to.eql(95000);});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
