          {
            "key": "Idempotency-Key",
            "value": "movie-hold-{{runId}}"
          }
        ],
        "url": "{{baseUrl}}/api/movie/holds",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"showId\": \"{{showId}}\",\n  \"seatNumbers\": [\n    61,\n    1,\n    21\n  ],\n  \"buyerId\": \"buyer-{{runId}}\",\n  \"ttlSeconds\": 900\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
