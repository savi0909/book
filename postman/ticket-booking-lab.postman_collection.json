{
  "info": {
    "name": "Ticket booking interview lab",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order. Local simulation only, no charges. New event per run; all state retained. Polls wait 250ms and stop after 60 attempts."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "setTimeout(()=>{},250); // Bound polling pace in Postman/Newman."
        ]
      }
    }
  ],
