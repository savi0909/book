    {
      "name": "Quarantine visible",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/payments/{{paymentId}}/recovery"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));pm.test('bounded three attempts',()=>{const r=pm.response.json();pm.expect(r.attempts).eql(3);pm.expect(r.itemFailures).eql(3);pm.expect(r.quarantinedAt).to.be.a('string');pm.expect(r.quarantineReason).eql('PoisonFixtureException');});"
            ]
          }
        }
      ]
    },
