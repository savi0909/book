          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));pm.test('healthy item progressed',()=>pm.expect(pm.response.json().state).eql('CONFIRMED'));"
            ]
          }
        }
      ]
    },
    {
      "name": "First failure is UNKNOWN",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/payments/{{paymentId}}/recovery"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));pm.test('isolated failure deferred',()=>{const r=pm.response.json();pm.expect(r.itemFailures).eql(1);pm.expect(r.state).eql('UNKNOWN');pm.expect(r.quarantinedAt).eql(null);});"
            ]
          }
        }
      ]
    },
    {
      "name": "Retry batch 2",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/demo/recovery/tick",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "setTimeout(() => {}, 1100);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));"
